# Service
NODE_ENV=development
HOST=0.0.0.0
PORT=1930

# Required secrets. Generate independent random values; never reuse a Postman token.
ADMIN_KEY=
API_KEY=
# 64 hexadecimal characters (32 random bytes).
ENCRYPTION_KEY=

# SQLite
DATABASE_PATH=./data/postman2api.db
# Set true on Railway after mounting a Volume at /app/data.
REQUIRE_PERSISTENT_STORAGE=false

# Browser login (recommended false on Railway)
ENABLE_BROWSER_LOGIN=true
CAMOUFOX_HEADLESS=true
# Optional override; the app discovers the local virtualenv by default.
PYTHON_PATH=

# Proxy bootstrap. Use a Railway private multiline variable; never commit credentials.
# Supported: http://, https://, host:port, host:port:user:pass, user:pass@host:port
PROXY_BOOTSTRAP=
PROXY_BOOTSTRAP_FILE=
PROXY_TEST_URL=https://api.ipify.org?format=json
PROXY_TEST_TIMEOUT_MS=10000

# Provider request protection
REQUEST_TIMEOUT_MS=120000
STREAM_FIRST_BYTE_TIMEOUT_MS=30000
STREAM_IDLE_TIMEOUT_MS=60000

# Account health scheduler
WARMUP_ENABLED=true
WARMUP_INTERVAL_MS=900000
